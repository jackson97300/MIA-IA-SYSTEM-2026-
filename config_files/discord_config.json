{
  "discord_notifications": {
    "verbosity": "normal",
    "description": "normal = Essentiels uniquement | verbose = Tout avec groupement | debug = Tout sans filtre",
    
    "filters": {
      "trade_executions": {
        "enabled": true,
        "description": "Notification trade ouvert"
      },
      "trade_closed": {
        "enabled": true,
        "min_pnl_notify": 0,
        "description": "Notification trade fermé (min_pnl_notify = notifier seulement si |P&L| > X)"
      },
      "signals_rejected": {
        "enabled": false,
        "aggregate": true,
        "window_minutes": 10,
        "description": "⚠️ TRÈS VERBOSE - Grouper rejets par 10 min si aggregate=true"
      },
      "heartbeat": {
        "enabled": true,
        "interval_minutes": 5,
        "description": "Status bot toutes les X minutes"
      },
      "kill_switch": {
        "enabled": true,
        "urgent": true,
        "description": "Alerte CRITIQUE Safety Kill Switch"
      },
      "daily_summary": {
        "enabled": true,
        "time": "23:59",
        "description": "Rapport quotidien P&L, Win Rate, etc."
      },
      "errors_critical": {
        "enabled": true,
        "urgent": true,
        "aggregate": false,
        "description": "Erreurs critiques (DTC disconnect, crash, etc.)"
      },
      "warnings": {
        "enabled": true,
        "aggregate": true,
        "window_minutes": 15,
        "description": "Warnings (VIX élevé, latence, etc.) - Groupés par 15 min"
      }
    },
    
    "aggregation": {
      "enabled": true,
      "default_window_minutes": 10,
      "max_buffer_size": 100,
      "description": "Groupement automatique messages similaires"
    },
    
    "rate_limiting": {
      "max_messages_per_minute": 10,
      "max_messages_per_hour": 200,
      "description": "Protection contre rate limit Discord"
    }
  }
}

