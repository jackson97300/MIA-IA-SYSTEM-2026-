  "rules": [
    {
      "id": "ELITE_01_LONG_BN_CONFLUENCE",
      "name": "🔥 LONG Elite: Battle Navale + Confluence Max",
      "description": "Signal LONG avec Battle Navale fort + Confluence élevée + Next Wall support",
      "priority": 10,
      "enabled": true,

      "conditions": {
        "and": [
          {
            "comment": "Battle Navale signal FORT (PRÉ-CALCULÉ)",
            "field": "battle_navale_signal_strength",
            "operator": ">=",
            "value": 0.70
          },
          {
            "comment": "Battle Navale confidence HAUTE",
            "field": "battle_navale_confidence",
            "operator": ">=",
            "value": 0.75
          },
          {
            "comment": "Confluence ÉLEVÉE (PRÉ-CALCULÉ)",
            "field": "confluence_strength",
            "operator": ">=",
            "value": 1.0
          },
          {
            "comment": "Smart Money Flow PAS trop négatif",
            "field": "smart_money_flow",
            "operator": ">=",
            "value": -0.30
          },
          {
            "comment": "Next Wall = PUT (support en dessous)",
            "field": "next_wall.side",
            "operator": "==",
            "value": "put"
          },
          {
            "comment": "Distance au mur < 10 ticks",
            "field": "next_wall.dist_ticks",
            "operator": "<=",
            "value": 10
          },
          {
            "comment": "Strength du mur > 0.6",
            "field": "next_wall.strength",
            "operator": ">=",
            "value": 0.6
          },
          {
            "comment": "Prix proche du VWAP (daily)",
            "field": "d_vwap_ticks",
            "operator": "between",
            "value": [-20, 20]
          },
          {
            "comment": "DOM pas trop déséquilibré contre nous",
            "field": "level1_imbalance",
            "operator": ">=",
            "value": -0.50
          }
        ]
      },

      "entry": {
        "side": "BUY",
        "type": "LIMIT",
        "price_strategy": "next_wall_price",
        "comment": "Entrer au niveau du put support"
      },

      "risk_management": {
        "stop_loss": {
          "strategy": "atr_based",
          "atr_multiplier": 1.5,
          "min_ticks": 8,
          "max_ticks": 20,
          "comment": "SL adaptatif selon ATR"
        },
        "take_profit": [
          {
            "target": 1,
            "strategy": "fixed_ticks",
            "ticks": 15,
            "quantity_percent": 50,
            "comment": "TP1: 15 ticks (50% position)"
          },
          {
            "target": 2,
            "strategy": "next_gex_level",
            "field": "gex_3",
            "quantity_percent": 50,
            "comment": "TP2: GEX_3 level (reste 50%)"
          }
        ],
        "breakeven": {
          "enabled": true,
          "trigger_ticks": 10,
          "offset_ticks": 2,
          "comment": "Breakeven +2 après +10 ticks"
        }
      },

      "position_sizing": {
        "base_size": 1,
        "confidence_scaling": true,
        "scaling_factor": "battle_navale_confidence",
        "max_size": 2,
        "comment": "Taille adaptée à la confiance"
      },

      "cooldown": {
        "bars": 5,
        "same_direction_only": true
      }
    },

