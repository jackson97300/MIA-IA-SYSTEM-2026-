  "description": "Règles Elite utilisant Battle Navale + MenthorQ + Confluence PRÉ-CALCULÉS",
  "symbols": ["ES", "NQ"],

  "global_filters": {
    "spread_ticks_max": 2,
    "volatility_regime_allowed": [1, 2],
