# ============================================
# .gitignore MIA_IA_SYSTEM
# ============================================

# ===== PYTHON =====
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
venv/
env/
ENV/

# ===== LOGS (CRITIQUES - GROS FICHIERS) =====
logs/
logs_advanced/
*.log
*.log.*

# ===== DATA & SNAPSHOTS (CRITIQUES - TRÈS GROS) =====
snapshots/
snapshots_trades/
CALIBRAGE_PHASE/SNAPSHOTS/
DATA_SIERRA_CHART/
data/
test_data/
ml_ready_data/
streams/
prop_firm_data/

# ===== BACKUPS & ARCHIVES =====
ARCHIVE/
*.zip
*.tar.gz
*.rar

# ===== MODELS ML (GROS FICHIERS) =====
models/
*.pkl
*.h5
*.pth
*.model

# ===== BACKTESTING RESULTS =====
backtesting/logs/
backtesting/results/
backtests/*/results/
*.csv

# ===== DEBUG FILES =====
debug_*.log
study_resolve_*.log
unified_debug_*.log
startup_*.txt

# ===== TEMP & CACHE =====
.cache/
.pytest_cache/
.mypy_cache/
*.tmp
*.temp

# ===== IDE =====
.vscode/
.idea/
*.swp
*.swo
*~

# ===== OS =====
.DS_Store
Thumbs.db
desktop.ini

# ===== CONFIG SECRETS =====
*.env
.env.*
secrets/
credentials/

# ===== WEBSITE BUILD =====
website/**/node_modules/
website/**/.next/
website/**/out/
website/**/*.log

# ===== KEEP STRUCTURE =====
!**/.gitkeep
