"""
Head Fake Detector (Tier 3) - ML_READY Optimized
Protection contre faux breakouts
"""
import time
from typing import Dict, Any, Optional
from dataclasses import dataclass
from datetime import datetime
from core.logger import get_logger

logger = get_logger(__name__)


# === HELPER FUNCTION: Volume Adaptif par Session/Symbole ===
def _volume_is_high(ml_data: Dict[str, Any]) -> bool:
    """Détermine si le volume est élevé selon la session et le symbole."""
    vol = ml_data.get('volume', 0)
    sess = ml_data.get('session_id', 'US')
    sym = (ml_data.get('sym', '') or '').upper()
    base = 35 if sess == 'Asia' else (45 if sess == 'EU' else 55)
    if 'NQ' in sym: base -= 3
    if 'RTY' in sym: base -= 5
    if ml_data.get('tick_rate_1s', 0) >= 1 or ml_data.get('trade_rate_1s', 0) >= 1:
        return vol >= base
    return vol >= (base + 5)

@dataclass
class PatternSignal:
    strategy: str
    timestamp: datetime
    side: Optional[str]
    confidence: float
    entry: float
    stop: float
    targets: list
    metadata: Dict[str, Any]
    processing_time_ms: float = 0.0

class HeadFakeDetector:
    """Tier 3: Détection + fade faux breakouts"""

    def __init__(self, config: Optional[Dict] = None):
        self.config = config or {}
        self.min_wick_ratio = self.config.get('min_wick_ratio', 0.40)  # Réduit de 0.60 à 0.40
        self.stats = {'signals_generated': 0, 'invalidations': 0}
        logger.info("✅ HeadFakeDetector initialisé (Tier 3)")

    def analyze_from_ml_ready(self, ml_data: Dict[str, Any]) -> Optional[PatternSignal]:
        """Analyse ML_READY - VERSION CORRIGÉE"""
        start_time = time.perf_counter()

        try:
            # ❌ PROBLÈME: wick_ratio_upper/lower et volume_climax n'existent pas
            # ✅ SOLUTION: Calculer depuis upper_wick_ticks et total_range_ticks

            upper_wick = ml_data.get('upper_wick_ticks', 0)
            lower_wick = ml_data.get('lower_wick_ticks', 0)
            total_range = ml_data.get('total_range_ticks', 1)

            wick_ratio_upper = upper_wick / total_range if total_range > 0 else 0
            wick_ratio_lower = lower_wick / total_range if total_range > 0 else 0

            # Volume climax - OPTIMISÉ (volume adaptatif session/symbole)
            if not _volume_is_high(ml_data):
                return None

            # Récupérer volume pour metadata
            volume = ml_data.get('volume', 0)

            # Déterminer side du fake
            if wick_ratio_upper >= self.min_wick_ratio:
                side = "SHORT"  # Fake breakout haut → SHORT
            elif wick_ratio_lower >= self.min_wick_ratio:
                side = "LONG"   # Fake breakout bas → LONG
            else:
                return None

            mid = ml_data.get('mid', 0)
            high = ml_data.get('high', mid)
            low = ml_data.get('low', mid)
            atr = ml_data.get('atr', 1.0)

            # Tick size dynamique
            symbol = ml_data.get('sym', 'NQ')
            tick_size = 0.25 if symbol in ['ES', 'NQ'] else 0.10

            # SL basé sur ATR
            sl_ticks = max(int(atr * 1.5 / tick_size), 8)

            if side == "SHORT":
                stop = high + (3 * tick_size)  # SL au-dessus du high
                tp1 = mid - (atr * 1.0)
                tp2 = mid - (atr * 2.0)
            else:
                stop = low - (3 * tick_size)  # SL en-dessous du low
                tp1 = mid + (atr * 1.0)
                tp2 = mid + (atr * 2.0)

            # Confidence basée sur wick_ratio
            confidence = max(wick_ratio_upper, wick_ratio_lower)

            signal = PatternSignal(
                strategy="head_fake_detector",
                timestamp=datetime.now(),
                side=side,
                confidence=confidence,
                entry=mid,
                stop=stop,
                targets=[tp1, tp2],
                metadata={
                    'wick_ratio_upper': wick_ratio_upper,
                    'wick_ratio_lower': wick_ratio_lower,
                    'volume': volume,
                    'volume_is_high': True,  # Déjà validé par _volume_is_high()
                    'atr': atr,
                    'source': 'ML_READY',
                    'validation': 'HEAD_FAKE_CALCULATED'
                },
                processing_time_ms=(time.perf_counter() - start_time) * 1000
            )

            self.stats['signals_generated'] += 1
            logger.info(f"✅ HeadFake: {side} @ {mid:.2f} (wick_upper={wick_ratio_upper:.2f}, wick_lower={wick_ratio_lower:.2f})")
            return signal

        except Exception as e:
            logger.error(f"❌ Erreur HeadFake: {e}")
            return None

    def can_invalidate(self, other_signal: PatternSignal, ml_data: Dict) -> bool:
        """Vérifie si HeadFake peut invalider un autre signal"""
        # HeadFake peut invalider si détection récente
        self.stats['invalidations'] += 1
        return True
